function desenharQuadrado(largura, altura) {
  for (let i = 1; i <= altura; i++) {
    let linha = "";
    for (let j = 1; j <= largura; j++) {
      if (i === 1 || i === altura || j === 1 || j === largura) {
        linha += "* ";
      } else {
        linha += "  ";
      }
    }
    console.log(linha);
  }
}

// Exemplo: 5 de largura por 5 de altura
desenharQuadrado(5, 5);
